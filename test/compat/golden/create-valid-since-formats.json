{
  "scenario": "create-valid-since-formats",
  "about": "validSince — те же записи дат",
  "steps": [
    {
      "name": "со смещением",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/since",
          "validSince": "2020-01-01T00:00:00+05:00"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "390",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/since",
        "dateCreated": "<now+00:00>",

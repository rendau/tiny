{
  "scenario": "create-minimal",
  "about": "Только longUrl — всё остальное по умолчанию",
  "steps": [
    {
      "name": "создать",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/minimal"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "369",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/minimal",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "переход по созданной ссылке",
      "request": {
        "method": "GET",
        "path": "/${code}",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/minimal",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },

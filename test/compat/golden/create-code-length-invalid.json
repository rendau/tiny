    {
      "name": "ноль",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/len-bad",
          "shortCodeLength": 0
        }
      },
      "status": 400,
      "headers": {
        "Content-Length": "163",
        "Content-Type": "application/problem+json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "invalidElements": [
          "shortCodeLength"
        ],
        "title": "Invalid data",

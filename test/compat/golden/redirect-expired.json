{
  "scenario": "redirect-expired",
  "about": "Срок действия ссылки истёк (validUntil в прошлом)",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/expired",
          "validUntil": "2020-01-01T00:00:00+05:00"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "392",

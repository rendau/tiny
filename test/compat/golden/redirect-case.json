{
  "scenario": "redirect-case",
  "about": "Регистр кода важен — aBcDe и abcde это разные ссылки",
  "steps": [
    {
      "name": "создать ссылку aBcDe…",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "customSlug": "aBcDe${run}",
          "longUrl": "https://shop.example.invalid/${run}/case-mixed"
        }
      },
      "status": 200,
      "headers": {
        "Content-Length": "384",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/aBcDe${run}",
        "shortCode": "aBcDe${run}",
        "longUrl": "https://shop.example.invalid/${run}/case-mixed",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,

{
  "scenario": "create-content-type",
  "about": "Заголовок Content-Type запроса — что принимается",
  "steps": [
    {
      "name": "JSON без Content-Type",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "body": "{\"longUrl\":\"https://shop.example.invalid/${run}/ct-none\"}"
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "369",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/ct-none",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },

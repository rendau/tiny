    {
      "name": "JSON, названный формой — не разбирается",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/x-www-form-urlencoded",
        "body": "{\"longUrl\":\"https://shop.example.invalid/${run}/ct-form-json\"}"
      },
      "status": 400,
      "headers": {
        "Content-Length": "155",
        "Content-Type": "application/problem+json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "invalidElements": [
          "longUrl"
        ],
        "title": "Invalid data",
        "type": "https://shlink.io/api/error/invalid-data",
        "status": 400,
        "detail": "Provided data is not valid"
      }
    }
  ]

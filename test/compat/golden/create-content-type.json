    {
      "name": "форма (application/x-www-form-urlencoded)",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/x-www-form-urlencoded",
        "body": "longUrl=https%3A%2F%2Fshop.example.invalid%2F${run}%2Fct-form&tags%5B%5D=mail_sms&findIfExists=true"
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "379",
        "Content-Type": "application/json",

{
  "scenario": "redirect-forward-off",
  "about": "forwardQuery=false — параметры короткой ссылки не дописываются",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "forwardQuery": false,
          "longUrl": "https://shop.example.invalid/${run}/nofwd?a=1"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "372",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/nofwd?a=1",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": false,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "без параметров",
      "request": {
        "method": "GET",
        "path": "/${code}",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/nofwd?a=1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },
    {
      "name": "с параметрами",
      "request": {
        "method": "GET",
        "path": "/${code}?z=9&a=2",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/nofwd?a=1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    }
  ]
}

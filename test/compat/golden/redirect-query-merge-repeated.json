{
  "scenario": "redirect-query-merge-repeated",
  "about": "В длинном адресе один ключ встречается дважды",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/rep?x=1&x=2&y=1"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "387",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/rep?x=1&x=2&y=1",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "без параметров",
      "request": {
        "method": "GET",
        "path": "/${code}",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/rep?x=1&x=2&y=1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },
    {
      "name": "тот же ключ один раз",
      "request": {
        "method": "GET",
        "path": "/${code}?x=3",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/rep?x=3&y=1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },
    {
      "name": "другой ключ",
      "request": {
        "method": "GET",
        "path": "/${code}?z=3",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/rep?x=1&x=2&y=1&z=3",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    }
  ]
}

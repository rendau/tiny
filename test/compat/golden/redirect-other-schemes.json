{
  "scenario": "redirect-other-schemes",
  "about": "Длинный адрес не http — ссылка в приложение",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "tg://resolve?domain=sample_${run}"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "359",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "tg://resolve?domain=sample_${run}",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "GET",
      "request": {
        "method": "GET",
        "path": "/${code}",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "tg://resolve?domain=sample_${run}",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },
    {
      "name": "GET с параметром",
      "request": {
        "method": "GET",
        "path": "/${code}?start=1",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "tg://resolve?domain=sample_${run}&start=1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    }
  ]
}

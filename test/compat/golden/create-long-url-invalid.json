{
  "scenario": "create-long-url-invalid",
  "about": "Пустой, отсутствующий и неверный longUrl",
  "steps": [
    {
      "name": "пустая строка",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": ""
        }
      },
      "status": 400,
      "headers": {
        "Content-Length": "155",
        "Content-Type": "application/problem+json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "invalidElements": [
          "longUrl"
        ],
        "title": "Invalid data",
        "type": "https://shlink.io/api/error/invalid-data",
        "status": 400,
        "detail": "Provided data is not valid"
      }
    },
    {

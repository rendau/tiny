{
  "scenario": "redirect-valid-window",
  "about": "Сейчас внутри срока действия (validSince в прошлом, validUntil в будущем)",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/window",
          "validSince": "2020-01-01T00:00:00+05:00",
          "validUntil": "2099-12-05T10:01:00+05:00"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "414",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/window",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": "2019-12-31T19:00:00+00:00",
          "validUntil": "2099-12-05T05:01:00+00:00",
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "GET",
      "request": {
        "method": "GET",
        "path": "/${code}",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/window",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    }
  ]
}

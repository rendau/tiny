{
  "scenario": "read-auth",
  "about": "Ключ API при чтении",
  "steps": [
    {
      "name": "создать",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/read-auth"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "371",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/read-auth",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "без ключа",
      "request": {
        "method": "GET",
        "path": "/rest/v3/short-urls/${code}",
        "host": "l.demo.test"
      },
      "status": 401,
      "headers": {
        "Content-Length": "243",
        "Content-Type": "application/problem+json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "expectedHeaders": [
          "X-Api-Key"
        ],
        "title": "Invalid authorization",
        "type": "https://shlink.io/api/error/missing-authentication",
        "status": 401,
        "detail": "Expected one of the following authentication headers, [\"X-Api-Key\"], but none were provided"
      }
    },
    {
      "name": "неверный ключ",
      "request": {
        "method": "GET",
        "path": "/rest/v3/short-urls/${code}",
        "host": "l.demo.test",
        "key": "bad"
      },
      "status": 401,
      "headers": {
        "Content-Length": "151",
        "Content-Type": "application/problem+json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "title": "Invalid API key",
        "type": "https://shlink.io/api/error/invalid-api-key",
        "status": 401,
        "detail": "Provided API key does not exist or is invalid."
      }
    },
    {
      "name": "без ключа и ссылки нет — сначала проверяется ключ",
      "request": {
        "method": "GET",
        "path": "/rest/v3/short-urls/x${run}",
        "host": "l.demo.test"
      },
      "status": 401,
      "headers": {
        "Content-Length": "243",
        "Content-Type": "application/problem+json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "expectedHeaders": [
          "X-Api-Key"
        ],
        "title": "Invalid authorization",
        "type": "https://shlink.io/api/error/missing-authentication",
        "status": 401,
        "detail": "Expected one of the following authentication headers, [\"X-Api-Key\"], but none were provided"
      }
    }
  ]
}

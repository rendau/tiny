{
  "scenario": "redirect-path-variants",
  "about": "Косая черта в конце и лишние части пути",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/path"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "366",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/path",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "косая черта в конце",
      "request": {
        "method": "GET",
        "path": "/${code}/",
        "host": "l.demo.test"
      },
      "status": 404,
      "headers": {
        "Content-Length": "1428",
        "Content-Type": "text/html; charset=utf-8",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "text",
      "body_file": "bodies/cb22168235ad.html"
    },
    {
      "name": "лишняя часть пути",
      "request": {

        "path": "/${code}?a[]=1&a[]=2",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/forward?a%5B%5D=1&a%5B%5D=2",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },
    {
      "name": "ключ со скобками в закодированном виде",
      "request": {
        "method": "GET",
        "path": "/${code}?a%5B%5D=1&a%5B%5D=2",
        "host": "l.demo.test"
      },
      "status": 302,

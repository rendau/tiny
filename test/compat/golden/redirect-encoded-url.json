{
  "scenario": "redirect-encoded-url",
  "about": "Длинный адрес, уже закодированный отправителем (проценты, плюсы)",
  "steps": [
    {
      "name": "создать ссылку",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/%D0%BF%D0%BE%D0%B8%D1%81%D0%BA?q=%D0%B0+%D0%B1%20%D0%B2&e=a%26b&p=1%2B1"
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "443",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/%D0%BF%D0%BE%D0%B8%D1%81%D0%BA?q=%D0%B0+%D0%B1%20%D0%B2&e=a%26b&p=1%2B1",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": null,
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {
      "name": "GET",
      "request": {
        "method": "GET",
        "path": "/${code}",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/%D0%BF%D0%BE%D0%B8%D1%81%D0%BA?q=%D0%B0%20%D0%B1%20%D0%B2&e=a%26b&p=1%2B1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    },
    {
      "name": "GET с параметром",
      "request": {
        "method": "GET",
        "path": "/${code}?z=1",
        "host": "l.demo.test"
      },
      "status": 302,
      "headers": {
        "Content-Length": "0",
        "Location": "https://shop.example.invalid/${run}/%D0%BF%D0%BE%D0%B8%D1%81%D0%BA?q=%D0%B0%20%D0%B1%20%D0%B2&e=a%26b&p=1%2B1&z=1",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "empty"
    }
  ]
}

        "method": "GET",
        "path": "/${codeSl}",
        "host": "other.example.invalid"
      },
      "status": 404,
      "headers": {
        "Content-Length": "1488",
        "Content-Type": "text/html; charset=utf-8",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "text",

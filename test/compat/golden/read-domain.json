{
  "scenario": "read-domain",
  "about": "Параметр domain при чтении",
  "steps": [
    {
      "name": "создать ссылку второго домена",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "domain": "sl.demo.test",
          "longUrl": "https://shop.example.invalid/${run}/read-sl"
        }
      },
      "saved": {
        "codeSl": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "380",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://sl.demo.test/${codeSl}",
        "shortCode": "${codeSl}",
        "longUrl": "https://shop.example.invalid/${run}/read-sl",
        "dateCreated": "<now+00:00>",
        "tags": [],
        "meta": {
          "validSince": null,
          "validUntil": null,
          "maxVisits": null
        },
        "domain": "sl.demo.test",
        "title": null,
        "crawlable": false,
        "forwardQuery": true,
        "visitsSummary": {
          "total": 0,
          "nonBots": 0,
          "bots": 0
        },
        "hasRedirectRules": false
      }
    },
    {

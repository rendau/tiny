{
  "scenario": "create-find-if-exists-custom-slug",
  "about": "findIfExists вместе с customSlug",
  "steps": [
    {
      "name": "создать со своим кодом",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "customSlug": "fie-${run}",
          "findIfExists": true,
          "longUrl": "https://shop.example.invalid/${run}/fie-slug"
        }
      },
      "status": 200,
      "headers": {
        "Content-Length": "380",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/fie-${run}",
        "shortCode": "fie-${run}",
        "longUrl": "https://shop.example.invalid/${run}/fie-slug",

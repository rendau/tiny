{
  "scenario": "create-tags",
  "about": "Метки приводятся к одному виду — строчные буквы, дефисы вместо пробелов",
  "steps": [
    {
      "name": "разный регистр, пробелы, html",
      "request": {
        "method": "POST",
        "path": "/rest/v3/short-urls",
        "host": "l.demo.test",
        "key": "good",
        "content_type": "application/json",
        "body_json": {
          "longUrl": "https://shop.example.invalid/${run}/tags",
          "tags": [
            "Compat Big Tag",
            "  compat-trim  ",
            "COMPAT-DUP",
            "<b>compat-bold</b>",
            "Compat Метка"
          ]
        }
      },
      "saved": {
        "code": "shortCode =~ ^[0-9a-zA-Z]{5}$"
      },
      "status": 200,
      "headers": {
        "Content-Length": "463",
        "Content-Type": "application/json",
        "X-Request-Id": "<uuid>"
      },
      "body_kind": "json",
      "body_json": {
        "shortUrl": "https://l.demo.test/${code}",
        "shortCode": "${code}",
        "longUrl": "https://shop.example.invalid/${run}/tags",
        "dateCreated": "<now+00:00>",
        "tags": [

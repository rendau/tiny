DEBUG=true
LOG_LEVEL=info

# API админки
GRPC_PORT=5050
HTTP_PORT=9090
HTTP_CORS=true
JWT_SECRET=dev-secret

# публичный сервер (совместим с Shlink)
PUBLIC_PORT=8080
API_KEYS=dev-api-key
# те же ключи хешем (sha256 в hex, как в api_keys.key у Shlink), через запятую
#API_KEY_HASHES=
# писать в журнал каждый запрос создания ссылки с телом (на время: в адресах могут быть личные данные)
LOG_CREATE_REQUESTS=true
DEFAULT_DOMAIN=localhost:8080
IS_HTTPS_ENABLED=false
DEFAULT_SHORT_CODES_LENGTH=5

# интерфейс админки
ADMIN_PORT=8001
ADMIN_DIR=./admin-ui
ADMIN_API_BASE_URL=http://localhost:9090

#PG_DSN="postgres://tiny:tiny@localhost:54340/tiny?sslmode=disable"
